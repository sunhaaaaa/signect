VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Authentication > Sign-in method > Add provider > OpenID Connect.
# Whatever provider ID you type there (Firebase forces an "oidc." prefix,
# e.g. "oidc.kakao") — must match exactly, or Kakao sign-in fails.
VITE_KAKAO_OIDC_PROVIDER_ID=oidc.kakao
